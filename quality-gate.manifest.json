{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.19.0/schemas/schema.json",
  "services": [
    {
      "product": "Orchestration",
      "component": "relying-party-configuration",
      "promotionType": "securePipelines",
      "automated": [
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "secret scanning"
            }
          ],
          "file": ".github/workflows/validation.yml",
          "path": "$.jobs.style-checks"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "unit"
            }
          ],
          "file": ".github/workflows/unit-tests.yml",
          "path": "$.jobs.unit-test"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "integration"
            }
          ],
          "file": ".github/workflows/integration-tests.yml",
          "path": "$.jobs.integration-test"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code quality"
            },
            {
              "name": "unit test coverage"
            }
          ],
          "file": ".github/workflows/sonarcloud.yml",
          "path": "$.jobs.check"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            }
          ],
          "file": ".github/workflows/terraform-checks.yml",
          "path": "$.jobs.terraform-format"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            }
          ],
          "file": ".github/workflows/terraform-checks.yml",
          "path": "$.jobs.terraform-validate"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            }
          ],
          "file": ".github/workflows/checkov.yml",
          "path": "$.jobs.checkov"
        }
      ]
    }
  ]
}
