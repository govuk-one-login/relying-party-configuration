{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.14.0/schemas/schema.json",
  "services": [
    {
      "product": "Orchestration",
      "component": "relying-party-configuration",
      "promotionType": "securePipelines",
      "automated": [
        {
          "checkTypes": [
            "code style and linting",
            "secret scanning"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/validation.yml",
            "path": "$.jobs.style-checks"
          }
        },
        {
          "checkTypes": [
            "unit"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/unit-tests.yml",
            "path": "$.jobs.unit-test"
          }
        },
        {
          "checkTypes": [
            "integration"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/integration-tests.yml",
            "path": "$.jobs.integration-test"
          }
        },
        {
          "checkTypes": [
            "code quality",
            "unit test coverage"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/sonarcloud.yml",
            "path": "$.jobs.check"
          }
        },
        {
          "checkTypes": [
            "code style and linting"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/terraform-checks.yml",
            "path": "$.jobs.terraform-format"
          }
        },
        {
          "checkTypes": [
            "code style and linting"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/terraform-checks.yml",
            "path": "$.jobs.terraform-validate"
          }
        },
        {
          "checkTypes": [
            "code style and linting"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/checkov.yml",
            "path": "$.jobs.checkov"
          }
        }
      ]
    }
  ]
}
